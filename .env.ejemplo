# Configuracion de Base de Datos y Cache
DATABASE_URL=postgres://admin:secreto@127.0.0.1:5432/api_db
REDIS_URL=redis://127.0.0.1:6379

# Configuracion del Servidor Backend y Version de API
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
API_PREFIX=/api/v1

# Configuracion Horaria y Formato
TIMEZONE=America/Caracas
TIME_FORMAT=12h

# Politicas de Seguridad y Cuotas
COOLDOWN_SECONDS=15
MAX_BODY_LIMIT_MB=15
RUST_LOG=info
