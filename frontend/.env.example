# URL Base de la API del Sistema Biometrico Rapture
# Cambie la version (ej: /api/v2) o el host en esta unica variable
VITE_API_BASE_URL=/api/v1

# Configuracion de Zona Horaria y Formato de 12 Horas
# Parametrizable: por defecto America/Caracas (GMT-4)
VITE_TIMEZONE=America/Caracas
VITE_TIME_FORMAT=12h
